# Server-only Django origin. Do not prefix with NEXT_PUBLIC_.
# The browser talks to Next.js; Next.js calls this URL.
#
# Staging (self-signed certificate). `npm run dev` trusts certs/staging.crt.
API_URL=https://13.140.168.156:8443
#
# HTTP fallback if the staging certificate cannot be trusted:
# API_URL=http://13.140.168.156:8088
#
# Production (offline host, nginx in front): set API_URL in the process
# environment to the internal Django origin, for example:
# API_URL=http://127.0.0.1:8000
