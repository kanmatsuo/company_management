{
  "name": "management-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_EXTRA_CA_CERTS=certs/staging.crt NEXT_TELEMETRY_DISABLED=1 next dev",
